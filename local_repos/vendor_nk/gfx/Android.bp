    name: "libgbm_mesa",
    vendor: true,
    compile_multilib: "64",
    strip: { none: true },
    check_elf_files: false,
    shared_libs: ["libcutils", "libdrm"],
    arch: { arm64: { srcs: ["mesa/libgbm_mesa.so"] } },
    required: ["libgbm_symlink"],
}

install_symlink {
    name: "libgbm_symlink",
    vendor: true,
    installed_location: "lib64/libgbm.so",
    symlink_target: "libgbm_mesa.so",
}

