//
// vendor/nk/gfx - Mesa Panfrost 24.0.9 + s6kms DRM/KMS HWC (minigbm + s6_drm_gralloc compat)
//

soong_namespace {
}

cc_library_shared {
    name: "hwcomposer.s6kms",
    relative_install_path: "hw",
    vendor: true,
    compile_multilib: "64",
    srcs: ["s6_kms_hwcomposer.cpp"],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Wno-unused-parameter",
        "-Wno-missing-field-initializers",
    ],
    header_libs: [
        "libhardware_headers",
        "libsystem_headers",
    ],
    shared_libs: [
        "libdrm",
        "liblog",
        "libcutils",
    ],
    required: [
        "hwcomposer.samsungexynos7420_symlink",
    ],
}

install_symlink {
    name: "hwcomposer.samsungexynos7420_symlink",
    vendor: true,
    installed_location: "lib64/hw/hwcomposer.samsungexynos7420.so",
    symlink_target: "hwcomposer.s6kms.so",
}

install_symlink {
    name: "gralloc.default.32_symlink",
    vendor: true,
    installed_location: "lib/hw/gralloc.default.so",
    symlink_target: "gralloc.minigbm.so",
}

install_symlink {
    name: "gralloc.default.64_symlink",
    vendor: true,
    installed_location: "lib64/hw/gralloc.default.so",
    symlink_target: "gralloc.minigbm.so",
}

cc_prebuilt_library_shared {
    name: "libnk_c++_shared",
    stem: "libc++_shared",
    vendor: true,
    compile_multilib: "64",
    strip: { none: true },
    check_elf_files: false,
    arch: { arm64: { srcs: ["mesa/libc++_shared.so"] } },
}

cc_prebuilt_library_shared {
    name: "libglapi",
    vendor: true,
    compile_multilib: "64",
    strip: { none: true },
    check_elf_files: false,
    arch: { arm64: { srcs: ["mesa/libglapi.so"] } },
}

