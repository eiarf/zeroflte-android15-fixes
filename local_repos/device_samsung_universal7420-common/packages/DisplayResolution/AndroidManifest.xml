<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.samsung.exynos7420.displayresolution"
    android:sharedUserId="android.uid.system">

    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.INTERACT_ACROSS_USERS" />

    <application
        android:icon="@drawable/ic_screen_resolution"
        android:allowBackup="false"
        android:label="@string/screen_resolution_title"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.DisplayResolution">

        <activity
            android:name=".DisplayResolutionActivity"
            android:label="@string/screen_resolution_title"
            android:icon="@drawable/ic_screen_resolution"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.display" />
            <meta-data
                android:name="com.android.settings.summary_uri"
                android:value="content://com.samsung.exynos7420.displayresolution.summary/resolution" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/resolution_summary_fallback" />
            <meta-data
                android:name="com.android.settings.order"
                android:value="50" />
            <meta-data
                android:name="com.android.settings.profile"
                android:value="primary_profile_only" />
        </activity>

        <provider
            android:name=".SummaryProvider"
            android:authorities="com.samsung.exynos7420.displayresolution.summary"
            android:exported="true" />
    </application>
</manifest>
