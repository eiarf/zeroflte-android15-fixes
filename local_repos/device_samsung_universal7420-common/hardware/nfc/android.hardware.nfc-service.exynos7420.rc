on post-fs
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -a -d /vendor/lib/modules max86900 sec_nfc

on post-fs-data
    mkdir /data/vendor/nfc 0770 nfc nfc
    chown nfc nfc /dev/sec-nfc
    chmod 0660 /dev/sec-nfc

service nfc_hal_service /vendor/bin/hw/android.hardware.nfc-service.exynos7420
    class hal
    user nfc
    group nfc
