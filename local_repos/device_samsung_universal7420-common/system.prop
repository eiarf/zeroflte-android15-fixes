# Boot device
ro.boot.bootdevice=15570000.ufs

# Dalvik
dalvik.vm.dex2oat64.enabled=true

# HWC / SurfaceFlinger (balanced 60Hz composition on Exynos 7420 / Panfrost)
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.sf.blurs_are_expensive=1
debug.renderengine.backend=skiaglthreaded
debug.sf.predict_hwc_composition_strategy=0
# SurfaceFlinger main on the A57s without ADPF dropping it to 400-600 MHz A53s
debug.sf.enable_adpf_cpu_hint=false
debug.sf.latch_unsignaled=1
debug.sf.early.app.duration=16600000
debug.sf.late.sf.duration=10500000
debug.sf.early.sf.duration=13500000
debug.sf.earlyGl.app.duration=16600000
debug.sf.earlyGl.sf.duration=13500000
ro.surface_flinger.enable_frame_rate_override=false
ro.surface_flinger.uclamp.min=600
debug.hwui.use_hint_manager=true

# Media (no IOmx service declared on 6.6)
debug.stagefright.c2inputsurface=-1

# LMKD
ro.lmk.log_stats=true

# NFC
ro.nfc.fw_dl_on_boot=false

# Recovery
persist.vendor.recovery_update=false

# Board. ro.arch is platform-owned (build_prop), so init refuses it
# from vendor properties.
ro.arch=exynos7420
