;; HW bring-up: IR + gpsd fix
(genfscon sysfs "/devices/virtual/sensors/irled_remote" (u object_r sysfs_sensors_writable ((s0) (s0))))
(allow hal_ir_default sysfs_sensors (dir (ioctl read getattr lock open watch watch_reads search)))
(allow hal_ir_default sysfs_sensors (lnk_file (read getattr open)))
(allow hal_ir_default sysfs_sensors_writable (dir (ioctl read getattr lock open watch watch_reads search)))
(allow hal_ir_default sysfs_sensors_writable (file (ioctl read write getattr lock append map open watch watch_reads)))
(allow hal_ir_default sysfs_ssp_iio (dir (ioctl read getattr lock open watch watch_reads search)))
(allow hal_ir_default sysfs_ssp_iio (lnk_file (ioctl read getattr lock map open watch watch_reads)))
(allow hal_ir_default sysfs_ssp_iio (file (ioctl read write getattr lock append map open watch watch_reads)))
(dontaudit gpsd radio_prop_202404 (file (read getattr map open)))
(allow gpsd system_file_202404 (file (read getattr open)))
