on fs
    setprop ro.gps.chip.vendor BCM4773_EXERCISE

on post-fs-data
    mkdir /data/system/gps 0771 gps system
    chown gps system /data/system/gps
    chmod 0771 /data/system/gps
    rm /data/system/gps/gps_started
    rm /data/system/gps/glonass_started
    rm /data/system/gps/beidou_started
    rm /data/system/gps/smd_started
    rm /data/system/gps/sv_cno.info

service gpsd /vendor/bin/hw/gpsd -c /vendor/etc/gnss/gps.xml
    class main
    user gps
    group system wakelock inet net_raw

service gnss_service /vendor/bin/hw/android.hardware.gnss-service.universal7420
    class hal
    user gps
    group system gps radio
