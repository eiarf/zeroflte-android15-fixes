diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
index 7f8b2227c..ebf989933 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
@@ -2635,21 +2635,53 @@ static int brcmf_pcie_pm_enter_D3(struct device *dev)
 	devinfo->mbdata_completed = false;
 	brcmf_pcie_send_mb_data(devinfo, BRCMF_H2D_HOST_D3_INFORM);
 
-	wait_event_timeout(devinfo->mbdata_resp_wait, devinfo->mbdata_completed,
-			   BRCMF_PCIE_MBDATA_TIMEOUT);
+	/*
+	 * BCM4358 missing-MSI erratum (Samsung dhd_pcie CSP:999857): the
+	 * dongle can write BRCMF_D2H_DEV_D3_ACK to shared TCM while its MSI
+	 * is lost entering L1. Poll shared MB data in 50 ms slices up to
+	 * BRCMF_PCIE_MBDATA_TIMEOUT so a lost MSI never stalls or kills Wi-Fi.
+	 */
+	{
+		unsigned long slice = msecs_to_jiffies(50);
+		unsigned int waited_ms = 0;
+
+		while (!devinfo->mbdata_completed &&
+		       waited_ms < jiffies_to_msecs(BRCMF_PCIE_MBDATA_TIMEOUT)) {
+			wait_event_timeout(devinfo->mbdata_resp_wait,
+					   devinfo->mbdata_completed, slice);
+			if (!devinfo->mbdata_completed)
+				brcmf_pcie_handle_mb_data(devinfo);
+			waited_ms += 50;
+		}
+	}
 	if (!devinfo->mbdata_completed) {
 		brcmf_err(bus, "Timeout on response for entering D3 substate\n");
-		brcmf_bus_change_state(bus, BRCMF_BUS_UP);
-		brcmf_pcie_fwcon_timer(devinfo, true);
-		/* A dongle that misses the D3 ACK keeps missing it, and every
-		 * later system suspend would fail here. Recover it the way a
-		 * halted firmware is recovered: reset the bus, which reloads
-		 * the firmware once this suspend has been aborted.
+		/*
+		 * Never call brcmf_fw_crashed() from suspend_late while
+		 * userspace is frozen (request_firmware is rejected and leaves
+		 * phy0 permanently down). Restore D0 in-place per dhd_pcie.c.
 		 */
-		brcmf_fw_crashed(dev);
+		if (brcmf_pcie_read_reg32(devinfo, devinfo->reginfo->intmask) !=
+		    0xffffffff) {
+			brcmf_pcie_send_mb_data(devinfo,
+				BRCMF_H2D_HOST_D0_INFORM_IN_USE |
+				BRCMF_H2D_HOST_D0_INFORM);
+			brcmf_bus_change_state(bus, BRCMF_BUS_UP);
+			brcmf_pcie_intr_enable(devinfo);
+			brcmf_pcie_fwcon_timer(devinfo, true);
+			return -EBUSY;
+		}
+		devinfo->state = BRCMFMAC_PCIE_STATE_DOWN;
 		return -EIO;
 	}
 
+	/*
+	 * Tell BCM4358 before PCIe enters D3 that host wakeup will use
+	 * H2D_HOST_D0_INFORM, then mask host mailbox interrupts (matching
+	 * Samsung dhd_pcie.c lines 3393-3395).
+	 */
+	brcmf_pcie_send_mb_data(devinfo, BRCMF_H2D_HOST_D0_INFORM_IN_USE);
+	brcmf_pcie_intr_disable(devinfo);
 	devinfo->state = BRCMFMAC_PCIE_STATE_DOWN;
 
 	return 0;
@@ -2679,8 +2711,6 @@ static int brcmf_pcie_pm_leave_D3(struct device *dev)
 		brcmf_dbg(PCIE, "Try to wakeup device....\n");
 		if (brcmf_pcie_send_mb_data(devinfo, BRCMF_H2D_HOST_D0_INFORM))
 			goto cleanup;
-		if (brcmf_pcie_send_mb_data(devinfo, BRCMF_H2D_HOST_D0_INFORM_IN_USE))
-			goto cleanup;
 		brcmf_dbg(PCIE, "Hot resume, continue....\n");
 		devinfo->state = BRCMFMAC_PCIE_STATE_UP;
 		brcmf_pcie_select_core(devinfo, BCMA_CORE_PCIE2);
