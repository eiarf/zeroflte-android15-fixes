 		queue_work(ssi->tx_wq, &ssi->tx_work);
 	return ret;
 }
@@ -492,25 +494,48 @@ static void bbd_ssi_complete(struct device *dev)
 
 static int bbd_ssi_suspend(struct device *dev)
 {
+	struct spi_device *spi = to_spi_device(dev);
 	struct bbd_device *bbd = dev_get_drvdata(dev);
+	struct bbd_ssi *ssi = bbd->ssi;
 
 	/* The sensor hub child suspended first: send what it queued. */
-	flush_work(&bbd->ssi->tx_work);
-	WRITE_ONCE(bbd->ssi->quiet, false);
+	flush_work(&ssi->tx_work);
+
+	/*
+	 * Disable the threaded IRQ and block new SPI bursts before parent
+	 * 14d30000.spi suspends its queue (-ESHUTDOWN / -108). Exynos EINT
+	 * wake-masking via enable_irq_wake() still wakes the AP on HOST_REQ.
+	 */
+	disable_irq(spi->irq);
+	mutex_lock(&ssi->xfer_lock);
+	WRITE_ONCE(ssi->suspended, true);
+	mutex_unlock(&ssi->xfer_lock);
+	cancel_work_sync(&ssi->tx_work);
 
-	/* The hub keeps sampling in suspend; HOST_REQ wakes the AP. */
+	WRITE_ONCE(ssi->quiet, false);
 	if (device_may_wakeup(dev))
-		enable_irq_wake(to_spi_device(dev)->irq);
+		enable_irq_wake(spi->irq);
 	return 0;
 }
 
 static int bbd_ssi_resume(struct device *dev)
 {
+	struct spi_device *spi = to_spi_device(dev);
 	struct bbd_device *bbd = dev_get_drvdata(dev);
+	struct bbd_ssi *ssi = bbd->ssi;
 
 	if (device_may_wakeup(dev))
-		disable_irq_wake(to_spi_device(dev)->irq);
-	queue_work(bbd->ssi->tx_wq, &bbd->ssi->tx_work);
+		disable_irq_wake(spi->irq);
+
+	mutex_lock(&ssi->xfer_lock);
+	WRITE_ONCE(ssi->suspended, false);
+	mutex_unlock(&ssi->xfer_lock);
+	enable_irq(spi->irq);
+
+	if (gpiod_get_value_cansleep(ssi->host_req))
+		pm_wakeup_dev_event(dev, 200, false);
+
+	queue_work(ssi->tx_wq, &ssi->tx_work);
 	return 0;
 }
 
