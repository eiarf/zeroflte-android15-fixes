diff --git a/arch/arm64/configs/zeroflte_gki.fragment b/arch/arm64/configs/zeroflte_gki.fragment
index 2e4cc6a1b..7fd538415 100644
--- a/arch/arm64/configs/zeroflte_gki.fragment
+++ b/arch/arm64/configs/zeroflte_gki.fragment
@@ -119,7 +119,9 @@ CONFIG_RD_LZ4=y
 # CONFIG_XZ_DEC_SPARC is not set
 
 # Bring-up: faster builds without LTO (kCFI does not need it).
-CONFIG_LTO_NONE=y
+# CONFIG_LTO_NONE is not set
+CONFIG_LTO_CLANG_THIN=y
+CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
 
 # kheaders.ko packs the kernel headers for BPF tools with GNU tar options
 # macOS tar lacks, and nothing on the phone reads them.
@@ -169,7 +171,7 @@ CONFIG_LTO_NONE=y
 # unless userspace cancels it once the boot completes. The hardware
 # watchdog runs from its probe (s3c2410_wdt.tmr_atboot). firmware_class.path
 # lets drivers such as brcmfmac load firmware straight from /vendor/firmware.
-CONFIG_CMDLINE="slub_debug=FZPU,kmalloc-16 cgroup_disable=pressure kasan.stacktrace=off bootconfig clk_ignore_unused pd_ignore_unused deferred_probe_timeout=0 fw_devlink=permissive rodata=on loglevel=8 printk.devkmsg=on ignore_loglevel log_buf_len=4M dsh_autorecovery=150 s3c2410_wdt.tmr_atboot=1 firmware_class.path=/vendor/firmware"
+CONFIG_CMDLINE="stack_depot_disable=on cgroup_disable=pressure kasan.stacktrace=off bootconfig clk_ignore_unused pd_ignore_unused deferred_probe_timeout=0 fw_devlink=permissive rodata=on loglevel=4 printk.devkmsg=on log_buf_len=4M dsh_autorecovery=150 s3c2410_wdt.tmr_atboot=1 firmware_class.path=/vendor/firmware"
 
 # Size: the Image must fit the 28 MiB BOOT partition with the ROM ramdisk.
 # The A57/A53 have no pointer authentication, so the PAC-to-SCS patching
@@ -274,7 +276,7 @@ CONFIG_SND_SOC_SAMSUNG_ZERO_WM1840=m
 # tracepoint and its sys_call_table dispatcher (GKI mode).
 CONFIG_KSU=y
 CONFIG_KSU_MANUAL_SU=y
-# CONFIG_KPM is not set
+CONFIG_KPM=y
 # CONFIG_KSU_DISABLE_MANAGER is not set
 # CONFIG_KSU_DISABLE_POLICY is not set
 # KernelSU finds sys_call_table, security_hook_heads and other data
@@ -406,3 +408,27 @@ CONFIG_CRYPTO_LZO=y
 # Disable BTF to avoid 5.6MB allocated .BTF section in Image exceeding 28MB boot partition
 # CONFIG_DEBUG_INFO_BTF is not set
 # CONFIG_DEBUG_INFO_BTF_MODULES is not set
+# Networking: BBR default + FQ qdisc + IPSET + IPv6 NAT/Masquerade
+CONFIG_TCP_CONG_BBR=y
+CONFIG_DEFAULT_BBR=y
+CONFIG_DEFAULT_TCP_CONG="bbr"
+CONFIG_NET_SCH_FQ=y
+CONFIG_IP_SET=y
+CONFIG_IP_SET_MAX=256
+CONFIG_IP_SET_HASH_IP=y
+CONFIG_IP_SET_HASH_NET=y
+CONFIG_IP_SET_HASH_IPPORT=y
+CONFIG_IP_SET_HASH_IPPORTNET=y
+CONFIG_IP_SET_BITMAP_IP=y
+CONFIG_NETFILTER_XT_SET=y
+CONFIG_IP6_NF_NAT=y
+CONFIG_IP6_NF_TARGET_MASQUERADE=y
+CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
+
+# Mountify / TMPFS xattr + OverlayFS
+CONFIG_TMPFS_XATTR=y
+CONFIG_TMPFS_POSIX_ACL=y
+CONFIG_OVERLAY_FS=y
+
+# ZRAM LZ4HC alongside LZ4/LZO
+CONFIG_CRYPTO_LZ4HC=y
