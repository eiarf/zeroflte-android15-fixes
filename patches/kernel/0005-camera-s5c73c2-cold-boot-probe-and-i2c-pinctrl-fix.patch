+static int s5c73c2_power_on_and_boot(struct s5c73c2 *c2)
+{
+	int attempt, ret = -ENXIO;
+
+	for (attempt = 0; attempt < 3; attempt++) {
+		ret = s5c73c2_power_on(c2);
+		if (ret)
+			return ret;
+
+		ret = s5c73c2_identify_and_boot(c2);
+		if (!ret)
+			return 0;
+
+		dev_warn(c2->dev,
+			 "boot attempt %d/3 failed (%d), recovering I2C bus\n",
+			 attempt + 1, ret);
+		s5c73c2_power_off(c2, ARRAY_SIZE(s5c73c2_supplies));
+		if (c2->client && c2->client->adapter)
+			i2c_recover_bus(c2->client->adapter);
+		msleep(50);
+	}
+
+	return ret;
+}
