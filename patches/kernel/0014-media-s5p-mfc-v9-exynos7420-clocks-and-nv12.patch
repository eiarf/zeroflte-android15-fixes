+	fsize->stepwise.max_width = IS_MFCV8_PLUS(dev) ? 3840 : 1920;
+	fsize->stepwise.step_width = 16;
+	fsize->stepwise.min_height = 32;
+	fsize->stepwise.max_height = IS_MFCV8_PLUS(dev) ? 2160 : 1088;
+	fsize->stepwise.step_height = 16;
+	return 0;
