+static void exynos_iommu_get_resv_regions(struct device *dev,
+					  struct list_head *list)
+{
+	of_iommu_get_resv_regions(dev, list);
+
+	/*
+	 * Exynos7420 MFC v9 firmware computes internal RISC addresses relative to
+	 * RISC_BASE_ADDRESS and rejects any buffer whose IOVA is below it or
+	 * >= 3 GiB above it with error 0x37. Reserve [0..0x40000000) so FW sits
+	 * at 0x40000000 and all DMA allocations stay inside [0x40000000..0xfeffffff].
+	 */
+	if (dev->of_node &&
+	    of_device_is_compatible(dev->of_node, "samsung,exynos7420-mfc")) {
+		struct iommu_resv_region *region;
+
+		region = iommu_alloc_resv_region(0, 0x40000000ULL, 0,
+						 IOMMU_RESV_RESERVED,
+						 GFP_KERNEL);
+		if (region)
+			list_add_tail(&region->list, list);
+	}
+}
