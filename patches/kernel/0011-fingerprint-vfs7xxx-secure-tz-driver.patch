+static int vfsspi_parse_dt(struct device *dev, struct vfsspi_device_data *data)
+{
+	struct device_node *np = dev->of_node;
+
+	data->sleep_gpio = devm_gpiod_get(dev, "sleep", GPIOD_OUT_LOW);
+	if (IS_ERR(data->sleep_gpio))
+		return dev_err_probe(dev, PTR_ERR(data->sleep_gpio), "sleep-gpios\n");
+
+	data->drdy_gpio = devm_gpiod_get(dev, "drdy", GPIOD_IN);
+	if (IS_ERR(data->drdy_gpio))
+		return dev_err_probe(dev, PTR_ERR(data->drdy_gpio), "drdy-gpios\n");
+
+	data->ldo_gpio = devm_gpiod_get(dev, "ldo", GPIOD_OUT_LOW);
+	if (IS_ERR(data->ldo_gpio))
+		return dev_err_probe(dev, PTR_ERR(data->ldo_gpio), "ldo-gpios\n");
+
+	data->ldo2_gpio = devm_gpiod_get_optional(dev, "ldo2", GPIOD_OUT_LOW);
+	if (IS_ERR(data->ldo2_gpio))
+		return dev_err_probe(dev, PTR_ERR(data->ldo2_gpio), "ldo2-gpios\n");
+
+	data->ocp_en = of_property_read_bool(np, "vfsspi-ocpen-smc");
+	if (of_property_read_u32(np, "vfsspi-ldocontrol", &data->ldocontrol))
+		data->ldocontrol = 1;
+	if (of_property_read_u32(np, "vfsspi-orient", &data->orient))
+		data->orient = 0;
+
+	data->detect_mode = DETECT_NORMAL;
+#ifdef ENABLE_SENSORS_FPRINT_SECURE
+	data->tz_mode = true;
+#endif
+
+	data->fp_spi_pclk = devm_clk_get(dev, "fp-spi-pclk");
+	if (IS_ERR(data->fp_spi_pclk))
+		return dev_err_probe(dev, PTR_ERR(data->fp_spi_pclk), "fp-spi-pclk\n");
+
+	data->fp_spi_sclk = devm_clk_get(dev, "fp-spi-sclk");
+	if (IS_ERR(data->fp_spi_sclk))
+		return dev_err_probe(dev, PTR_ERR(data->fp_spi_sclk), "fp-spi-sclk\n");
+
+	data->p = devm_pinctrl_get_select_default(dev);
+	if (IS_ERR(data->p))
+		return dev_err_probe(dev, PTR_ERR(data->p), "pinctrl default\n");
+
+	data->pins_sleep = pinctrl_lookup_state(data->p, PINCTRL_STATE_SLEEP);
+	if (IS_ERR(data->pins_sleep))
+		return dev_err_probe(dev, PTR_ERR(data->pins_sleep), "pinctrl sleep\n");
+
+	data->pins_idle = pinctrl_lookup_state(data->p, PINCTRL_STATE_IDLE);
+	if (IS_ERR(data->pins_idle))
+		return dev_err_probe(dev, PTR_ERR(data->pins_idle), "pinctrl idle\n");
+
+	dev_info(dev, "DT parsed: ocp_smc=%d ldocontrol=%u orient=%u\n",
+		 data->ocp_en, data->ldocontrol, data->orient);
+	return 0;
+}
