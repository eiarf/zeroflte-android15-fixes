diff --git a/arch/arm64/boot/dts/exynos/exynos7420-zeroflte.dts b/arch/arm64/boot/dts/exynos/exynos7420-zeroflte.dts
index aafd1282a..04a372263 100644
--- a/arch/arm64/boot/dts/exynos/exynos7420-zeroflte.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7420-zeroflte.dts
@@ -2934,6 +2934,79 @@ s5k4e6_out: endpoint {
 	};
 };
 
+/*
+ * Fingerprint sensor (Synaptics/Validity VFS7XXX): TrustZone/MobiCore owns
+ * SPI4 (0x14d70000) and gpv7 (pinctrl_ese, kept disabled). Linux handles
+ * normal-world LDOs (gpf1-6/7), reset/sleep (gpf3-4), DRDY IRQ (gpa0-7),
+ * SPI4 clocks from CMU_TOP0, and OCP/PM SMCs.
+ */
+&pinctrl_alive {
+	btp_irq: btp-irq-pins {
+		samsung,pins = "gpa0-7";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV4>;
+	};
+
+	btp_irqsleep: btp-irq-sleep-pins {
+		samsung,pins = "gpa0-7";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV4>;
+	};
+
+	btp_irqidle: btp-irq-idle-pins {
+		samsung,pins = "gpa0-7";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;
+		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV4>;
+	};
+};
+
+&pinctrl_bus1 {
+	btp_ldo: btp-ldo-pins {
+		samsung,pins = "gpf1-6";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
+	};
+
+	btp_ldo2: btp-ldo2-pins {
+		samsung,pins = "gpf1-7";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
+	};
+
+	btp_reset: btp-reset-pins {
+		samsung,pins = "gpf3-4";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
+	};
+};
+
+&soc {
+	vfsspi_fp: vfsspi {
+		compatible = "vfsspi,vfs7xxx";
+		pinctrl-names = "default", "sleep", "idle";
+		pinctrl-0 = <&btp_irq &btp_reset &btp_ldo &btp_ldo2>;
+		pinctrl-1 = <&btp_irqsleep>;
+		pinctrl-2 = <&btp_irqidle>;
+		clocks = <&clock_top0 CLK_ACLK_PERIC1_66>,
+			 <&clock_top0 CLK_SCLK_SPI4>;
+		clock-names = "fp-spi-pclk", "fp-spi-sclk";
+		sleep-gpios = <&gpf3 4 GPIO_ACTIVE_HIGH>;
+		drdy-gpios = <&gpa0 7 GPIO_ACTIVE_HIGH>;
+		ldo-gpios = <&gpf1 6 GPIO_ACTIVE_HIGH>;
+		ldo2-gpios = <&gpf1 7 GPIO_ACTIVE_HIGH>;
+		vfsspi-ocpen-smc;
+		vfsspi-ldocontrol = <1>;
+		vfsspi-orient = <0>;
+		status = "okay";
+	};
+};
+
 &csis1 {
 	status = "okay";
 
