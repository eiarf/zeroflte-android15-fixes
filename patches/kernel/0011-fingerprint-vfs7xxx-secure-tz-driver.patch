diff --git a/drivers/fingerprint/fingerprint_sysfs.c b/drivers/fingerprint/fingerprint_sysfs.c
new file mode 100644
index 000000000..f817bda6b
--- /dev/null
+++ b/drivers/fingerprint/fingerprint_sysfs.c
@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (C) 2013 Samsung Electronics. All rights reserved.
+ */
+
+#include <linux/module.h>
+#include <linux/types.h>
+#include <linux/init.h>
+#include <linux/device.h>
+#include <linux/fs.h>
+#include <linux/err.h>
+
+struct class *fingerprint_class;
+EXPORT_SYMBOL_GPL(fingerprint_class);
+
+static void set_fingerprint_attr(struct device *dev,
+				 struct device_attribute *attributes[])
+{
+	int i;
+
+	for (i = 0; attributes[i] != NULL; i++)
+		if (device_create_file(dev, attributes[i]) < 0)
+			pr_err("%s: fail device_create_file(attributes[%d])\n",
+			       __func__, i);
+}
+
+int fingerprint_register(struct device **dev_out, void *drvdata,
+			 struct device_attribute *attributes[], const char *name)
+{
+	struct device *dev;
+	int ret;
+
+	if (!fingerprint_class) {
+		fingerprint_class = class_create("fingerprint");
+		if (IS_ERR(fingerprint_class)) {
+			ret = PTR_ERR(fingerprint_class);
+			fingerprint_class = NULL;
+			return ret;
+		}
+	}
+
+	dev = device_create(fingerprint_class, NULL, 0, drvdata, "%s", name);
+	if (IS_ERR(dev)) {
+		ret = PTR_ERR(dev);
+		pr_err("%s: device_create failed (%d)\n", __func__, ret);
+		return ret;
+	}
+
+	set_fingerprint_attr(dev, attributes);
+	if (dev_out)
+		*dev_out = dev;
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(fingerprint_register);
+
+void fingerprint_unregister(struct device *dev,
+			    struct device_attribute *attributes[])
+{
+	int i;
+
+	if (!dev)
+		return;
+
+	for (i = 0; attributes[i] != NULL; i++)
+		device_remove_file(dev, attributes[i]);
+
+	device_unregister(dev);
+}
+EXPORT_SYMBOL_GPL(fingerprint_unregister);
+
+void destroy_fingerprint_class(void)
+{
+	if (fingerprint_class) {
+		class_destroy(fingerprint_class);
+		fingerprint_class = NULL;
+	}
+}
+EXPORT_SYMBOL_GPL(destroy_fingerprint_class);
+
+static int __init fingerprint_class_init(void)
+{
+	fingerprint_class = class_create("fingerprint");
+	if (IS_ERR(fingerprint_class)) {
+		pr_err("%s: class_create failed (%ld)\n",
+		       __func__, PTR_ERR(fingerprint_class));
+		return PTR_ERR(fingerprint_class);
+	}
+	return 0;
+}
+
+static void __exit fingerprint_class_exit(void)
+{
+	destroy_fingerprint_class();
+}
+
+subsys_initcall(fingerprint_class_init);
+module_exit(fingerprint_class_exit);
+
+MODULE_DESCRIPTION("fingerprint sysfs class");
+MODULE_LICENSE("GPL");
diff --git a/drivers/fingerprint/vfs7xxx.c b/drivers/fingerprint/vfs7xxx.c
new file mode 100644
index 000000000..8ac324744
--- /dev/null
+++ b/drivers/fingerprint/vfs7xxx.c
@@ -0,0 +1,1029 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Synaptics/Validity VFS7XXX Fingerprint Sensor Driver (/dev/vfsspi)
+ * Ported for Samsung Galaxy S6 (Exynos 7420 / zeroflte) on Linux 6.6
+ * in TrustZone/MobiCore secure SPI mode.
+ */
+
+#include "fingerprint.h"
+#include "vfs7xxx.h"
+
+#include <linux/cdev.h>
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/errno.h>
+#include <linux/fs.h>
+#include <linux/gpio/consumer.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/ioctl.h>
+#include <linux/jiffies.h>
+#include <linux/kernel.h>
+#include <linux/list.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/pinctrl/consumer.h>
+#include <linux/platform_device.h>
+#include <linux/pm_wakeup.h>
+#include <linux/rcupdate.h>
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/sched/task.h>
+#include <linux/slab.h>
+#include <linux/timer.h>
+#include <linux/uaccess.h>
+
+#define VALIDITY_PART_NAME "validity_fingerprint"
+#define VENDOR             "SYNAPTICS"
+#define CHIP_ID            "VIPER"
+
+static LIST_HEAD(device_list);
+static DEFINE_MUTEX(device_list_mutex);
+static struct class *vfsspi_device_class;
+
+struct vfsspi_device_data {
+	dev_t devt;
+	struct cdev cdev;
+	spinlock_t vfs_spi_lock;
+	struct platform_device *pdev;
+	struct list_head device_entry;
+	struct mutex buffer_mutex;
+	struct mutex kernel_lock;
+	unsigned int is_opened;
+	unsigned char *buffer;
+	unsigned char *null_buffer;
+	struct gpio_desc *drdy_gpio;
+	struct gpio_desc *sleep_gpio;
+	struct gpio_desc *ldo_gpio;
+	struct gpio_desc *ldo2_gpio;
+	int gpio_irq;
+	int cnt_irq;
+	struct task_struct *t;
+	int user_pid;
+	int signal_id;
+	unsigned int current_spi_speed;
+	atomic_t irq_enabled;
+	bool ldo_onoff;
+	spinlock_t irq_lock;
+	unsigned int ldocontrol;
+	bool ocp_en;
+	struct work_struct work_debug;
+	struct workqueue_struct *wq_dbg;
+	struct timer_list dbg_timer;
+	struct pinctrl *p;
+	struct pinctrl_state *pins_sleep;
+	struct pinctrl_state *pins_idle;
+	bool tz_mode;
+	struct device *fp_device;
+	bool enabled_clk;
+	struct clk *fp_spi_pclk;
+	struct clk *fp_spi_sclk;
+#ifdef FEATURE_SPI_WAKELOCK
+	struct wakeup_source *fp_spi_lock;
+	struct wakeup_source *fp_signal_lock;
+#endif
+	int sensortype;
+	unsigned int orient;
+	unsigned int detect_mode;
+};
+
+static struct vfsspi_device_data *g_data;
+static bool fp_lockscreen_mode;
+
+#ifdef CONFIG_SENSORS_FINGERPRINT_SYSFS
+extern int fingerprint_register(struct device **dev_out, void *drvdata,
+				struct device_attribute *attributes[], const char *name);
+extern void fingerprint_unregister(struct device *dev,
+				   struct device_attribute *attributes[]);
+#endif
+
+static int vfsspi_send_drdy_signal(struct vfsspi_device_data *vfsspi_device)
+{
+	int ret = 0;
+
+	pr_debug("%s\n", __func__);
+	if (vfsspi_device->t) {
+		ret = send_sig_info(vfsspi_device->signal_id,
+				    SEND_SIG_PRIV, vfsspi_device->t);
+		if (ret < 0)
+			pr_err("%s: error sending signal (%d)\n", __func__, ret);
+	} else {
+		pr_err("%s: task_struct is not received yet\n", __func__);
+	}
+	return ret;
+}
+
+#ifdef ENABLE_SENSORS_FPRINT_SECURE
+static int vfsspi_sec_spi_prepare(struct vfsspi_device_data *vfsspi_device,
+				  unsigned long speed)
+{
+	int ret;
+
+	if (IS_ERR_OR_NULL(vfsspi_device->fp_spi_pclk) ||
+	    IS_ERR_OR_NULL(vfsspi_device->fp_spi_sclk)) {
+		pr_err("%s: missing SPI4 clocks\n", __func__);
+		return -ENODEV;
+	}
+
+	ret = clk_prepare_enable(vfsspi_device->fp_spi_pclk);
+	if (ret) {
+		pr_err("%s: failed to enable fp_spi_pclk (%d)\n", __func__, ret);
+		return ret;
+	}
+
+	ret = clk_prepare_enable(vfsspi_device->fp_spi_sclk);
+	if (ret) {
+		pr_err("%s: failed to enable fp_spi_sclk (%d)\n", __func__, ret);
+		clk_disable_unprepare(vfsspi_device->fp_spi_pclk);
+		return ret;
+	}
+
+	ret = clk_set_rate(vfsspi_device->fp_spi_sclk, speed * 2);
+	if (ret)
+		pr_warn("%s: clk_set_rate(%lu) returned %d\n",
+			__func__, speed * 2, ret);
+
+	return 0;
+}
+
+static int vfsspi_sec_spi_unprepare(struct vfsspi_device_data *vfsspi_device)
+{
+	if (!IS_ERR_OR_NULL(vfsspi_device->fp_spi_sclk))
+		clk_disable_unprepare(vfsspi_device->fp_spi_sclk);
+	if (!IS_ERR_OR_NULL(vfsspi_device->fp_spi_pclk))
+		clk_disable_unprepare(vfsspi_device->fp_spi_pclk);
+	return 0;
+}
+#endif
+
+static void vfsspi_pin_control(struct vfsspi_device_data *vfsspi_device,
+			       bool pin_set)
+{
+	int status = 0;
+
+	if (!vfsspi_device->p)
+		return;
+
+	if (pin_set) {
+		if (!IS_ERR_OR_NULL(vfsspi_device->pins_idle)) {
+			status = pinctrl_select_state(vfsspi_device->p,
+						      vfsspi_device->pins_idle);
+			if (status)
+				pr_err("%s: can't set pin idle state (%d)\n",
+				       __func__, status);
+		}
+	} else {
+		if (!IS_ERR_OR_NULL(vfsspi_device->pins_sleep)) {
+			status = pinctrl_select_state(vfsspi_device->p,
+						      vfsspi_device->pins_sleep);
+			if (status)
+				pr_err("%s: can't set pin sleep state (%d)\n",
+				       __func__, status);
+		}
+	}
+}
+
+static int vfsspi_set_clk(struct vfsspi_device_data *vfsspi_device,
+			  unsigned long arg)
+{
+	int ret_val = 0;
+	unsigned short clock = 0;
+
+	if (copy_from_user(&clock, (void __user *)arg, sizeof(clock)) != 0)
+		return -EFAULT;
+
+	spin_lock_irq(&vfsspi_device->vfs_spi_lock);
+	switch (clock) {
+	case 0:
+		vfsspi_device->current_spi_speed = MAX_BAUD_RATE;
+		break;
+	case 0xFFFF:
+		vfsspi_device->current_spi_speed = SLOW_BAUD_RATE;
+		break;
+	default:
+		vfsspi_device->current_spi_speed = clock * BAUD_RATE_COEF;
+		if (vfsspi_device->current_spi_speed > MAX_BAUD_RATE)
+			vfsspi_device->current_spi_speed = MAX_BAUD_RATE;
+		break;
+	}
+	spin_unlock_irq(&vfsspi_device->vfs_spi_lock);
+
+	pr_info("%s: clk speed: %u\n", __func__, vfsspi_device->current_spi_speed);
+
+#ifdef ENABLE_SENSORS_FPRINT_SECURE
+	if (!vfsspi_device->enabled_clk) {
+		pr_info("%s: ENABLE_SPI_CLOCK\n", __func__);
+		ret_val = vfsspi_sec_spi_prepare(vfsspi_device,
+						 vfsspi_device->current_spi_speed);
+		if (ret_val == 0) {
+#ifdef FEATURE_SPI_WAKELOCK
+			if (vfsspi_device->fp_spi_lock)
+				__pm_stay_awake(vfsspi_device->fp_spi_lock);
+#endif
+			vfsspi_device->enabled_clk = true;
+		} else {
+			pr_err("%s: unable to enable spi clk (%d)\n", __func__, ret_val);
+		}
+	}
+#endif
+	return ret_val;
+}
+
+#ifdef ENABLE_SENSORS_FPRINT_SECURE
+static int vfsspi_ioctl_disable_spi_clock(struct vfsspi_device_data *vfsspi_device)
+{
+	int ret_val = 0;
+
+	if (vfsspi_device->enabled_clk) {
+		pr_info("%s: DISABLE_SPI_CLOCK\n", __func__);
+		ret_val = vfsspi_sec_spi_unprepare(vfsspi_device);
+#ifdef FEATURE_SPI_WAKELOCK
+		if (vfsspi_device->fp_spi_lock)
+			__pm_relax(vfsspi_device->fp_spi_lock);
+#endif
+		vfsspi_device->enabled_clk = false;
+	}
+	return ret_val;
+}
+#endif
+
+static int vfsspi_register_drdy_signal(struct vfsspi_device_data *vfsspi_device,
+				       unsigned long arg)
+{
+	struct vfsspi_ioctl_register_signal usr_signal;
+	struct task_struct *task = NULL;
+
+	if (copy_from_user(&usr_signal, (void __user *)arg,
+			   sizeof(usr_signal)) != 0) {
+		pr_err("%s: copy_from_user failed\n", __func__);
+		return -EFAULT;
+	}
+
+	vfsspi_device->user_pid = usr_signal.user_pid;
+	vfsspi_device->signal_id = usr_signal.signal_id;
+
+	if (vfsspi_device->t) {
+		put_task_struct(vfsspi_device->t);
+		vfsspi_device->t = NULL;
+	}
+
+	rcu_read_lock();
+	task = pid_task(find_pid_ns(vfsspi_device->user_pid, &init_pid_ns),
+			PIDTYPE_PID);
+	if (task)
+		get_task_struct(task);
+	rcu_read_unlock();
+
+	if (!task) {
+		pr_debug("%s: no such pid %d\n", __func__, vfsspi_device->user_pid);
+		return -ENODEV;
+	}
+
+	vfsspi_device->t = task;
+	pr_info("%s: registered PID=%d signal=%d\n",
+		__func__, vfsspi_device->user_pid, vfsspi_device->signal_id);
+	return 0;
+}
+
+static int vfsspi_enableIrq(struct vfsspi_device_data *vfsspi_device)
+{
+	unsigned long flags;
+
+	pr_info("%s\n", __func__);
+	spin_lock_irqsave(&vfsspi_device->irq_lock, flags);
+	if (atomic_read(&vfsspi_device->irq_enabled) == DRDY_IRQ_ENABLE) {
+		spin_unlock_irqrestore(&vfsspi_device->irq_lock, flags);
+		pr_debug("%s: DRDY irq already enabled\n", __func__);
+		return -EINVAL;
+	}
+	vfsspi_pin_control(vfsspi_device, true);
+	enable_irq(vfsspi_device->gpio_irq);
+	atomic_set(&vfsspi_device->irq_enabled, DRDY_IRQ_ENABLE);
+	vfsspi_device->cnt_irq++;
+	spin_unlock_irqrestore(&vfsspi_device->irq_lock, flags);
+	return 0;
+}
+
+static int vfsspi_disableIrq(struct vfsspi_device_data *vfsspi_device)
+{
+	unsigned long flags;
+
+	pr_info("%s\n", __func__);
+	spin_lock_irqsave(&vfsspi_device->irq_lock, flags);
+	if (atomic_read(&vfsspi_device->irq_enabled) == DRDY_IRQ_DISABLE) {
+		spin_unlock_irqrestore(&vfsspi_device->irq_lock, flags);
+		pr_debug("%s: DRDY irq already disabled\n", __func__);
+		return -EINVAL;
+	}
+	disable_irq_nosync(vfsspi_device->gpio_irq);
+	atomic_set(&vfsspi_device->irq_enabled, DRDY_IRQ_DISABLE);
+	vfsspi_pin_control(vfsspi_device, false);
+	vfsspi_device->cnt_irq--;
+	spin_unlock_irqrestore(&vfsspi_device->irq_lock, flags);
+	return 0;
+}
+
+static irqreturn_t vfsspi_irq(int irq, void *context)
+{
+	struct vfsspi_device_data *vfsspi_device = context;
+	unsigned long flags;
+
+	if (gpiod_get_value(vfsspi_device->drdy_gpio) == DRDY_ACTIVE_STATUS) {
+		spin_lock_irqsave(&vfsspi_device->irq_lock, flags);
+		if (atomic_read(&vfsspi_device->irq_enabled) == DRDY_IRQ_ENABLE) {
+			disable_irq_nosync(vfsspi_device->gpio_irq);
+			atomic_set(&vfsspi_device->irq_enabled, DRDY_IRQ_DISABLE);
+			vfsspi_pin_control(vfsspi_device, false);
+			vfsspi_device->cnt_irq--;
+			spin_unlock_irqrestore(&vfsspi_device->irq_lock, flags);
+			vfsspi_send_drdy_signal(vfsspi_device);
+#ifdef FEATURE_SPI_WAKELOCK
+			if (vfsspi_device->fp_signal_lock)
+				__pm_wakeup_event(vfsspi_device->fp_signal_lock, 3000);
+#endif
+			pr_info("%s: DRDY triggered, irq disabled\n", __func__);
+		} else {
+			spin_unlock_irqrestore(&vfsspi_device->irq_lock, flags);
+		}
+	}
+	return IRQ_HANDLED;
+}
+
+static int vfsspi_set_drdy_int(struct vfsspi_device_data *vfsspi_device,
+			       unsigned long arg)
+{
+	unsigned short drdy_enable_flag = 0;
+
+	if (copy_from_user(&drdy_enable_flag, (void __user *)arg,
+			   sizeof(drdy_enable_flag)) != 0) {
+		pr_err("%s: copy_from_user failed\n", __func__);
+		return -EFAULT;
+	}
+	if (drdy_enable_flag == 0) {
+		vfsspi_disableIrq(vfsspi_device);
+	} else {
+		vfsspi_enableIrq(vfsspi_device);
+		if (gpiod_get_value(vfsspi_device->drdy_gpio) == DRDY_ACTIVE_STATUS) {
+			pr_info("%s: DRDY already active\n", __func__);
+			vfsspi_send_drdy_signal(vfsspi_device);
+		}
+	}
+	return 0;
+}
+
+static void vfsspi_regulator_onoff(struct vfsspi_device_data *vfsspi_device,
+				   bool onoff)
+{
+#ifdef ENABLE_SENSORS_FPRINT_SECURE
+	int ret;
+#endif
+	if (!vfsspi_device->ldo_gpio)
+		return;
+
+	if (!vfsspi_device->ldocontrol) {
+		pr_info("%s: ldocontrol disabled\n", __func__);
+		return;
+	}
+
+	if (onoff) {
+#ifdef ENABLE_SENSORS_FPRINT_SECURE
+		if (vfsspi_device->ocp_en) {
+			ret = vfsspi_exynos_smc(MC_FC_FP_BTP_OCP_HIGH, 0, 0, 0);
+			pr_info("%s: ocp on, smc ret = %d\n", __func__, ret);
+			usleep_range(2950, 3000);
+		}
+#endif
+		if (vfsspi_device->ldo2_gpio)
+			gpiod_set_value(vfsspi_device->ldo2_gpio, 1);
+		gpiod_set_value(vfsspi_device->ldo_gpio, 1);
+	} else {
+		gpiod_set_value(vfsspi_device->ldo_gpio, 0);
+		if (vfsspi_device->ldo2_gpio)
+			gpiod_set_value(vfsspi_device->ldo2_gpio, 0);
+#ifdef ENABLE_SENSORS_FPRINT_SECURE
+		if (vfsspi_device->ocp_en) {
+			ret = vfsspi_exynos_smc(MC_FC_FP_BTP_OCP_LOW, 0, 0, 0);
+			pr_info("%s: ocp off, smc ret = %d\n", __func__, ret);
+		}
+#endif
+	}
+	vfsspi_device->ldo_onoff = onoff;
+	pr_info("%s: %s\n", __func__, onoff ? "on" : "off");
+}
+
+static void vfsspi_hardReset(struct vfsspi_device_data *vfsspi_device)
+{
+	pr_info("%s\n", __func__);
+	if (vfsspi_device && vfsspi_device->sleep_gpio) {
+		gpiod_set_value(vfsspi_device->sleep_gpio, 0);
+		mdelay(1);
+		gpiod_set_value(vfsspi_device->sleep_gpio, 1);
+		mdelay(5);
+	}
+}
+
+static void vfsspi_suspend(struct vfsspi_device_data *vfsspi_device)
+{
+	pr_info("%s\n", __func__);
+	if (vfsspi_device && vfsspi_device->sleep_gpio) {
+		spin_lock(&vfsspi_device->vfs_spi_lock);
+		gpiod_set_value(vfsspi_device->sleep_gpio, 0);
+		spin_unlock(&vfsspi_device->vfs_spi_lock);
+	}
+}
+
+static void vfsspi_ioctl_power_on(struct vfsspi_device_data *vfsspi_device)
+{
+	if (vfsspi_device->ldocontrol && !vfsspi_device->ldo_onoff)
+		vfsspi_regulator_onoff(vfsspi_device, true);
+}
+
+static void vfsspi_ioctl_power_off(struct vfsspi_device_data *vfsspi_device)
+{
+	if (vfsspi_device->ldocontrol && vfsspi_device->ldo_onoff) {
+		vfsspi_regulator_onoff(vfsspi_device, false);
+		if (vfsspi_device->sleep_gpio && gpiod_get_value(vfsspi_device->sleep_gpio))
+			gpiod_set_value(vfsspi_device->sleep_gpio, 0);
+	}
+}
