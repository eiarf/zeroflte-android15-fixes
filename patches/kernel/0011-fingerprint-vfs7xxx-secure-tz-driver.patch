+static int vfsspi_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct vfsspi_device_data *vfsspi_device;
+	struct device *cdev_node;
+	int status;
+
+	dev_info(dev, "%s\n", __func__);
+	vfsspi_device = devm_kzalloc(dev, sizeof(*vfsspi_device), GFP_KERNEL);
+	if (!vfsspi_device)
+		return -ENOMEM;
+
+	vfsspi_device->pdev = pdev;
+	spin_lock_init(&vfsspi_device->vfs_spi_lock);
+	spin_lock_init(&vfsspi_device->irq_lock);
+	mutex_init(&vfsspi_device->buffer_mutex);
+	mutex_init(&vfsspi_device->kernel_lock);
+	INIT_LIST_HEAD(&vfsspi_device->device_entry);
+	vfsspi_device->current_spi_speed = SLOW_BAUD_RATE;
+	vfsspi_device->sensortype = SENSOR_UNKNOWN;
+	atomic_set(&vfsspi_device->irq_enabled, DRDY_IRQ_DISABLE);
+
+	status = vfsspi_parse_dt(dev, vfsspi_device);
+	if (status)
+		return status;
+
+#ifdef ENABLE_SENSORS_FPRINT_SECURE
+	if (!vfsspi_device->ocp_en) {
+		status = vfsspi_exynos_smc(MC_FC_FP_BTP_OCP_NONE, 0, 0, 0);
+		pr_info("%s: ocp_none, smc ret = %d\n", __func__, status);
+	}
+#endif
+
+	vfsspi_device->gpio_irq = gpiod_to_irq(vfsspi_device->drdy_gpio);
+	if (vfsspi_device->gpio_irq < 0) {
+		dev_err(dev, "gpiod_to_irq failed (%d)\n", vfsspi_device->gpio_irq);
+		return vfsspi_device->gpio_irq;
+	}
+
+	status = devm_request_irq(dev, vfsspi_device->gpio_irq, vfsspi_irq,
+				  IRQF_TRIGGER_RISING, "vfsspi_irq", vfsspi_device);
+	if (status < 0) {
+		dev_err(dev, "request_irq failed (%d)\n", status);
+		return status;
+	}
+	disable_irq(vfsspi_device->gpio_irq);
+
+#ifdef FEATURE_SPI_WAKELOCK
+	vfsspi_device->fp_spi_lock = wakeup_source_register(dev, "vfsspi_wake_lock");
+	vfsspi_device->fp_signal_lock = wakeup_source_register(dev, "vfsspi_sigwake_lock");
+#endif
+
+	mutex_lock(&device_list_mutex);
+	status = alloc_chrdev_region(&vfsspi_device->devt, 0, 1, VALIDITY_PART_NAME);
+	if (status < 0) {
+		mutex_unlock(&device_list_mutex);
+		goto err_wakelock;
+	}
+
+	cdev_init(&vfsspi_device->cdev, &vfsspi_fops);
+	vfsspi_device->cdev.owner = THIS_MODULE;
+	status = cdev_add(&vfsspi_device->cdev, vfsspi_device->devt, 1);
+	if (status < 0) {
+		mutex_unlock(&device_list_mutex);
+		goto err_chrdev;
+	}
+
+	vfsspi_device_class = class_create("validity_fingerprint");
+	if (IS_ERR(vfsspi_device_class)) {
+		status = PTR_ERR(vfsspi_device_class);
+		mutex_unlock(&device_list_mutex);
+		goto err_cdev;
+	}
+
+	cdev_node = device_create(vfsspi_device_class, dev, vfsspi_device->devt,
+				  vfsspi_device, "vfsspi");
+	if (IS_ERR(cdev_node)) {
+		status = PTR_ERR(cdev_node);
+		mutex_unlock(&device_list_mutex);
+		goto err_class;
+	}
+
+	list_add(&vfsspi_device->device_entry, &device_list);
+	mutex_unlock(&device_list_mutex);
+
+	platform_set_drvdata(pdev, vfsspi_device);
+	g_data = vfsspi_device;
+
+#ifdef CONFIG_SENSORS_FINGERPRINT_SYSFS
+	status = fingerprint_register(&vfsspi_device->fp_device,
+				      vfsspi_device, fp_attrs, "fingerprint");
+	if (status)
+		goto err_dev;
+#endif
+
+	timer_setup(&vfsspi_device->dbg_timer, vfsspi_timer_func, 0);
+	vfsspi_device->wq_dbg = create_singlethread_workqueue("vfsspi_debug_wq");
+	if (!vfsspi_device->wq_dbg) {
+		status = -ENOMEM;
+		goto err_sysfs;
+	}
+	INIT_WORK(&vfsspi_device->work_debug, vfsspi_work_func_debug);
+
+	vfsspi_pin_control(vfsspi_device, false);
+	vfsspi_enable_debug_timer(vfsspi_device);
+
+	dev_info(dev, "VFS7XXX fingerprint probe successful (/dev/vfsspi)\n");
+	return 0;
+
+err_sysfs:
+#ifdef CONFIG_SENSORS_FINGERPRINT_SYSFS
+	fingerprint_unregister(vfsspi_device->fp_device, fp_attrs);
+err_dev:
+#endif
+	mutex_lock(&device_list_mutex);
+	list_del(&vfsspi_device->device_entry);
+	device_destroy(vfsspi_device_class, vfsspi_device->devt);
+	mutex_unlock(&device_list_mutex);
+err_class:
+	class_destroy(vfsspi_device_class);
+	vfsspi_device_class = NULL;
+err_cdev:
+	cdev_del(&vfsspi_device->cdev);
+err_chrdev:
+	unregister_chrdev_region(vfsspi_device->devt, 1);
+err_wakelock:
+#ifdef FEATURE_SPI_WAKELOCK
+	wakeup_source_unregister(vfsspi_device->fp_signal_lock);
+	wakeup_source_unregister(vfsspi_device->fp_spi_lock);
+#endif
+	g_data = NULL;
+	return status;
+}
+
+static int vfsspi_remove(struct platform_device *pdev)
+{
+	struct vfsspi_device_data *vfsspi_device = platform_get_drvdata(pdev);
+
+	if (!vfsspi_device)
+		return 0;
+
+	vfsspi_disable_debug_timer(vfsspi_device);
+	if (vfsspi_device->wq_dbg)
+		destroy_workqueue(vfsspi_device->wq_dbg);
+
+	if (vfsspi_device->enabled_clk)
+		vfsspi_ioctl_disable_spi_clock(vfsspi_device);
+	if (vfsspi_device->ldo_onoff)
+		vfsspi_regulator_onoff(vfsspi_device, false);
+
+#ifdef CONFIG_SENSORS_FINGERPRINT_SYSFS
+	fingerprint_unregister(vfsspi_device->fp_device, fp_attrs);
+#endif
+	mutex_lock(&device_list_mutex);
+	list_del(&vfsspi_device->device_entry);
+	device_destroy(vfsspi_device_class, vfsspi_device->devt);
+	class_destroy(vfsspi_device_class);
+	vfsspi_device_class = NULL;
+	cdev_del(&vfsspi_device->cdev);
+	unregister_chrdev_region(vfsspi_device->devt, 1);
+	mutex_unlock(&device_list_mutex);
+
+#ifdef FEATURE_SPI_WAKELOCK
+	wakeup_source_unregister(vfsspi_device->fp_signal_lock);
+	wakeup_source_unregister(vfsspi_device->fp_spi_lock);
+#endif
+	g_data = NULL;
+	return 0;
+}
+
+static void vfsspi_shutdown(struct platform_device *pdev)
+{
+	struct vfsspi_device_data *vfsspi_device = platform_get_drvdata(pdev);
+
+	if (vfsspi_device) {
+		vfsspi_disable_debug_timer(vfsspi_device);
+		vfsspi_ioctl_power_off(vfsspi_device);
+	}
+}
+
+static int vfsspi_pm_suspend(struct device *dev)
+{
+	struct vfsspi_device_data *vfsspi_device = dev_get_drvdata(dev);
+#ifdef ENABLE_SENSORS_FPRINT_SECURE
+	int ret;
+#endif
+
+	if (vfsspi_device) {
+		vfsspi_disable_debug_timer(vfsspi_device);
+		vfsspi_ioctl_power_off(vfsspi_device);
+#ifdef ENABLE_SENSORS_FPRINT_SECURE
+		ret = vfsspi_exynos_smc(MC_FC_FP_PM_SUSPEND, 0, 0, 0);
+		pr_info("%s: suspend smc ret=%d\n", __func__, ret);
+#endif
+	}
+	return 0;
+}
+
+static int vfsspi_pm_resume(struct device *dev)
+{
+	struct vfsspi_device_data *vfsspi_device = dev_get_drvdata(dev);
+#ifdef ENABLE_SENSORS_FPRINT_SECURE
+	int ret;
+#endif
+
+	if (vfsspi_device) {
+#ifdef ENABLE_SENSORS_FPRINT_SECURE
+		ret = vfsspi_exynos_smc(MC_FC_FP_PM_RESUME, 0, 0, 0);
+		pr_info("%s: resume smc ret=%d\n", __func__, ret);
+#endif
+		vfsspi_enable_debug_timer(vfsspi_device);
+	}
+	return 0;
+}
+
+static const struct dev_pm_ops vfsspi_pm_ops = {
+	.suspend = vfsspi_pm_suspend,
+	.resume = vfsspi_pm_resume,
+};
+
+static const struct of_device_id vfsspi_match_table[] = {
+	{ .compatible = "vfsspi,vfs7xxx" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, vfsspi_match_table);
+
+static struct platform_driver vfsspi_driver = {
+	.driver = {
+		.name = VALIDITY_PART_NAME,
+		.pm = &vfsspi_pm_ops,
+		.of_match_table = vfsspi_match_table,
+	},
+	.probe = vfsspi_probe,
+	.remove = vfsspi_remove,
+	.shutdown = vfsspi_shutdown,
+};
+module_platform_driver(vfsspi_driver);
+
+MODULE_DESCRIPTION("Synaptics/Validity VFS7XXX Fingerprint Sensor Driver");
+MODULE_LICENSE("GPL");
