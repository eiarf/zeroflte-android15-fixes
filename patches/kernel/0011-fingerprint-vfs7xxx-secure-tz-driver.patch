+static void vfsspi_work_func_debug(struct work_struct *work)
+{
+	struct vfsspi_device_data *data =
+		container_of(work, struct vfsspi_device_data, work_debug);
+	u8 ldo_value = 0;
+
+	if (data->ldo_gpio)
+		ldo_value |= gpiod_get_value(data->ldo_gpio) ? 1 : 0;
+	if (data->ldo2_gpio)
+		ldo_value |= gpiod_get_value(data->ldo2_gpio) ? 2 : 0;
+
+	pr_debug("%s: ldo:%u sleep:%d irq:%d tz:%d type:%s cnt_irq:%d adm:%u\n",
+		 __func__, ldo_value,
+		 data->sleep_gpio ? gpiod_get_value(data->sleep_gpio) : -1,
+		 data->drdy_gpio ? gpiod_get_value(data->drdy_gpio) : -1,
+		 data->tz_mode,
+		 sensor_status[data->sensortype + 1],
+		 data->cnt_irq, data->detect_mode);
+}
