From: zeroflte-rising17 <eiarf@users.noreply.github.com>
Subject: [PATCH] gms: slim pico gapps and use AOSP SetupWizard for 3GB RAM and small system

diff --git a/gms_pico.mk b/gms_pico.mk
index 78c3986..93dd196 100644
--- a/gms_pico.mk
+++ b/gms_pico.mk
@@ -15,6 +15,12 @@
 # limitations under the License.
 #
 #
+# Slimmed PICO profile for 3GB RAM / ~3GB SYSTEM partition devices (zeroflte):
+# Keeps Play Services (gmssystem.prodvic APEX + PrebuiltGmsCoreVic_*),
+# Play Store (Phonesky), GSF, SetupWizard, Restore, SettingsIntelligence,
+# WebViewGoogle + TrichromeLibrary, DocumentsUIGoogle, and TagGoogle.
+# Drops Pixel AI/TTS/TalkBack/Assistant/Wellbeing/replaceable Google apps
+# (~1.3 GiB saved in /system + hundreds of MB saved in background RAM).
 
 # APEX
 DISABLE_DEXPREOPT_CHECK := true
@@ -23,49 +29,27 @@ PRODUCT_PACKAGES += \
     com.google.android.gmssystem.prodvic
 
 # Quick Tap
-TARGET_SUPPORTS_QUICK_TAP ?= true
+TARGET_SUPPORTS_QUICK_TAP ?= false
 ifeq ($(TARGET_SUPPORTS_QUICK_TAP),true)
 PRODUCT_PACKAGES += \
     quick_tap
 endif
 
-# product/app
+# product/app (WebViewGoogle + TrichromeLibrary kept for system WebView)
 PRODUCT_PACKAGES += \
-    CalculatorGooglePrebuilt_85011599 \
-    Chrome \
-    Chrome-Stub \
-    GoogleContacts \
-    GoogleTTS \
-    LatinIMEGooglePrebuilt \
-    LocationHistoryPrebuilt \
-    MarkupGoogle_v2 \
-    PixelThemesStub2026 \
-    SoundPickerPrebuilt_3.4 \
     TrichromeLibrary \
     TrichromeLibrary-Stub \
     WebViewGoogle \
-    WebViewGoogle-Stub \
-    talkback
+    WebViewGoogle-Stub
 
-# product/priv-app
+# product/priv-app (Core GMS, Play Store, Setup & Sync only)
 PRODUCT_PACKAGES += \
-    AndroidAutoStubPrebuilt \
     ConfigUpdater \
-    DeviceIntelligenceNetworkPrebuiltAstrea \
-    GoogleDialer \
-    GoogleRestorePrebuilt-v1054408 \
-    KidsSupervisionStub \
     OdadPrebuilt \
     PartnerSetupPrebuilt \
     Phonesky \
-    PrebuiltDeskClockGoogle_76060331 \
-    PrebuiltPixelCoreServices \
     SettingsIntelligenceGooglePrebuilt \
-    SetupWizardPrebuilt_cd1a \
-    TurboPrebuilt \
-    VelvetGo \
-    VerifierPrebuiltClassic \
-    WellbeingPrebuilt
+    VerifierPrebuiltClassic
 
 # system/app
 PRODUCT_PACKAGES += \
@@ -77,21 +61,10 @@ PRODUCT_PACKAGES += \
     DocumentsUIGoogle \
     TagGoogle
 
-# system_ext/app
-PRODUCT_PACKAGES += \
-    EmergencyInfoGoogleNoUi \
-    Flipendo
-
 # system_ext/priv-app
